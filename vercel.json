{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "functions": {
    "api/index.js": {"maxDuration": 30},
    "api/hrms.js": {"maxDuration": 30},
    "api/auth/login.js": {"maxDuration": 30},
    "api/cron/attendance-reminder.js": {"maxDuration": 30},
    "api/push/public-key.js": {"maxDuration": 30},
    "api/push/subscribe.js": {"maxDuration": 30}
  },
  "crons": [{"path":"/api/cron/attendance-reminder","schedule":"15 5 * * *"}],
  "routes": [
    {"src":"/sw.js","dest":"/public/sw.js"},
    {"src":"/service-worker.js","dest":"/public/service-worker.js"},
    {"src":"/manifest.webmanifest","dest":"/public/manifest.webmanifest"},
    {"src":"/notifications.js","dest":"/public/notifications.js"},
    {"src":"/api/push/public-key","dest":"/api/push/public-key.js"},
    {"src":"/api/push/subscribe","dest":"/api/push/subscribe.js"},
    {"src":"/api/cron/attendance-reminder","dest":"/api/cron/attendance-reminder.js"},
    {"src":"/api/auth/login","dest":"/api/auth/login.js"},
    {"src":"/api/(.*)","dest":"/api/index?path=$1"},
    {"src":"/$","dest":"/api/index?path=__app__"}
  ],
  "headers": [{"source":"/api/(.*)","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]}]
}
